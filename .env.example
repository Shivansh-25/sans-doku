# Used only by the local puzzle importer, never sent to browsers.
YOUDOSUDOKU_API_KEY=
PUZZLES_PER_DIFFICULTY=10
# Local preview only. In production use: npx wrangler secret put SANS_PASSWORD
SANS_PASSWORD=
# Optional second sign-in (username: admin) for testing without touching the sans account. Production: npx wrangler secret put TESTER_PASSWORD
TESTER_PASSWORD=
